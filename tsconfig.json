{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@components/*": ["./src/components/*"],
            "@assets/*": ["./src/assets/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@/*": ["./src/*"]
        },
        "jsx": "preserve"
    },
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"]
}

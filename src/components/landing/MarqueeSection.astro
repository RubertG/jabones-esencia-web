---
import Marquee from "../common/Marquee.vue"

interface Props {
    className?: string
}

const { className } = Astro.props
---

<section class={`w-full overflow-hidden ${className}`}>
    <Marquee client:load pauseOnHover={true} gap={50}>
        <p class="text-lg text-word-950">
            Somos una empresa <span class="font-bold uppercase tracking-wide">totalmente artesanal</span> 🧼
        </p>
        <span class="text-word-950">|</span>
        <p class="text-lg text-word-950">
            Elaboramos productos con ingredientes <span class="font-bold uppercase tracking-wide">100% NATURALES</span> 🌿
        </p>
        <span class="text-word-950">|</span>
        <p class="text-lg text-word-950">
            Jabones para <span class="font-bold uppercase tracking-wide">cada tipo de piel</span> 👩‍🦰
        </p>
        <span class="text-word-950">|</span>
        <p class="text-lg text-word-950">
            Envíos para <span class="font-bold uppercase tracking-wide">todo el país</span> 🛒
        </p>
        <span class="text-word-950">|</span>
    </Marquee>
</section>

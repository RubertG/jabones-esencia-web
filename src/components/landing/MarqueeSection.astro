---
import Marquee from "../common/Marquee.vue"

interface Props {
    className?: string
}

const { className } = Astro.props
---

<section class={`w-full overflow-hidden ${className}`}>
    <Marquee client:load gap={50}>
        <p class="text-word-950 text-lg">
            Somos una empresa <span class="font-bold tracking-wide uppercase">totalmente artesanal</span> 🧼
        </p>
        <span class="text-word-950">|</span>
        <p class="text-word-950 text-lg">
            Elaboramos productos con ingredientes <span class="font-bold tracking-wide uppercase">100% NATURALES</span> 🌿
        </p>
        <span class="text-word-950">|</span>
        <p class="text-word-950 text-lg">
            Jabones para <span class="font-bold tracking-wide uppercase">cada tipo de piel</span> 👩‍🦰
        </p>
        <span class="text-word-950">|</span>
        <p class="text-word-950 text-lg">
            Envíos para <span class="font-bold tracking-wide uppercase">todo el país</span> 🛒
        </p>
        <span class="text-word-950">|</span>
    </Marquee>
</section>

---
import { client } from "@/lib/prismic"
import type { SlideBanner } from "@/types/banner"
import Banner from "@components/banner/Banner.vue"

const response = await client.getAllByType("banner")
const slides: SlideBanner[] = response.map(({ data }) => ({
    title: data.title,
    description: data.description?.[0]?.text,
    image: data.image?.url,
    route: data.route,
    textButton: data.text_button,
}))
---

<Banner slides={slides} client:load />

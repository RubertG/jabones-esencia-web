    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 px-4 xl:px-0 text-center">
        <p class="text-p2 text-word-800">
            &copy; <i>{year} Jabones Esencia Serena</i>. Todos los derechos reservados.
        </p>

        <p class="text-p2 text-word-800">
            Diseñado y desarrollado por <Link href="https://web-minds-col.com" target="_blank">WebMinds Colombia</Link>.
        </p>
    </div>
</footer>

---
import DividingLine from "@components/core/DividingLine.astro"
import BannerSection from "@components/landing/BannerSection.astro"
import BestSellers from "@components/landing/BestSellers.astro"
import CategoriesSection from "@components/landing/CategoriesSection.astro"
import MarqueeSection from "@components/landing/MarqueeSection.astro"
import HistorySection from "@components/landing/HistorySection.astro"
import BaseLayout from "@layouts/BaseLayout.astro"

export const prerender = true
---

<BaseLayout title="Jabones Esencia Serena" description="Productos artesanales para el cuidado de la piel">
    <BannerSection />
    <DividingLine />

    <MarqueeSection className="py-10" />
    <DividingLine />

    <BestSellers className="py-14 max-2xl:px-4" />
    <DividingLine />

    <CategoriesSection className="py-14 max-2xl:px-4" />
    <DividingLine />

    <HistorySection className="py-14 max-2xl:px-4" />
</BaseLayout>

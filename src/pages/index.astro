---
import BannerSection from "@components/landing/BannerSection.astro"
import CategoriesSection from "@components/landing/CategoriesSection.astro"
import MarqueeSection from "@components/landing/MarqueeSection.astro"
import BaseLayout from "@layouts/BaseLayout.astro"

export const prerender = true
---

<BaseLayout title="Jabones Esencia Serena" description="Productos artesanales para el cuidado de la piel">
    <BannerSection />

    <hr class="border-primary-200 w-full border-t" />

    <MarqueeSection className="py-8" />

    <hr class="border-primary-200 w-full border-t" />

    <CategoriesSection className="py-14 max-md:px-4" />
</BaseLayout>

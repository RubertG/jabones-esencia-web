---
import PaddingWrapper from "@components/common/PaddingWrapper.astro"
import StorybookLayout from "@layouts/StorybookLayout.astro"
---

<StorybookLayout title="Storybook | Jabones Esencia Serena">
    <PaddingWrapper class="space-y-4">
        <h1 class="text-h1-dark">Título 1</h1>
        <h2 class="text-h2-dark">Título 2</h2>
        <h3 class="text-h3-dark">Título 3</h3>
        <h4 class="text-h4-dark">Título 4</h4>
    </PaddingWrapper>

    <PaddingWrapper class="bg-secondary-600 space-y-4">
        <h1 class="text-h1-light">Título 1 Invertido</h1>
        <h2 class="text-h2-light">Título 2 Invertido</h2>
        <h3 class="text-h3-light">Título 3 Invertido</h3>
        <h4 class="text-h4-light">Título 4 Invertido</h4>
    </PaddingWrapper>
</StorybookLayout>
